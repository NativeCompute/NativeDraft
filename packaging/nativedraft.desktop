[Desktop Entry]
Type=Application
Name=NativeDraft
GenericName=Screenwriting
Comment=Write screenplays in standard format, stored as markdown
Exec=nativedraft %F
Icon=nativedraft
Terminal=false
Categories=Office;WordProcessor;AudioVideo;
Keywords=screenplay;script;screenwriting;film;fountain;fdx;final draft;markdown;
StartupNotify=true
StartupWMClass=nativedraft
